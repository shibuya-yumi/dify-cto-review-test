# 社内VM用環境変数設定

# Dify API設定
DIFY_API_KEY=your_dify_api_key_here
DIFY_API_URL=https://api.iruka.dev/v1/chat-messages

# GitHub設定
GITHUB_TOKEN=your_github_token_here

# サーバー設定
PORT=3000
NODE_ENV=production

# HTTPS設定（本番環境）
USE_HTTPS=true
SSL_KEY_PATH=/etc/ssl/private/server.key
SSL_CERT_PATH=/etc/ssl/certs/server.crt

# ログ設定
LOG_LEVEL=info
